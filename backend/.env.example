# ===========================================================================
# Backend environment variables.
# Local dev: copy to backend/.env  |  Vercel: add these in Project Settings.
# ===========================================================================

# --- DB driver -------------------------------------------------------------
# On Vercel the pure-JS mssql/tedious driver is selected automatically.
# Set DB_DRIVER=msnodesqlv8 locally only if you use Windows integrated auth.
# DB_DRIVER=mssql

# --- SQL Server connection -------------------------------------------------
DB_SERVER=your-sql-host
DB_DATABASE=ICAI_COMPLAINT
DB_USER=your_user
DB_PASSWORD=your_password
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true
# DB_INSTANCE=SQLEXPRESS
# DB_TRUSTED_CONNECTION=true   # local Windows integrated auth (msnodesqlv8 only)

# --- Auth ------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string

# --- Email (Gmail SMTP) ----------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com

# --- Frontend origin (CORS) ------------------------------------------------
CLIENT_URL=https://your-project.vercel.app

# --- File storage (Vercel Blob) --------------------------------------------
# Required on Vercel: create a Blob store in the project (Storage -> Blob ->
# Create Store) and Vercel sets this automatically. Leave empty for local dev,
# where uploads are written to the Documents folder on disk.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
